# Google OAuth Configuration (Backend Only)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Public Frontend Google Client ID (Next.js public environment variable)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# StudentHub Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# StudentHub JWT Secrets (Backend Only - NEVER expose to frontend)
JWT_SECRET=your-jwt-access-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here
